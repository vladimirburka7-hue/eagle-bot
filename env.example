# Скопируйте этот файл в .env и вставьте токен (Developer Portal -> Bot -> Reset Token).
# Файл .env никому не показывайте и не загружайте в интернет.
DISCORD_TOKEN=вставьте_токен_сюда

# ID вашего сервера (ПКМ по иконке сервера -> Копировать ID; нужен режим разработчика).
# С ним команды появятся сразу. Для публичного бота оставьте пустым.
DEV_GUILD_ID=

# 1 = читать текст сообщений (фильтр ссылок-приглашений).
# Только если включили Message Content Intent в Developer Portal.
USE_MESSAGE_CONTENT=0

# Необязательные настройки защиты:
MIN_ACCOUNT_AGE_DAYS=7
RAID_JOINS=5
RAID_WINDOW_SECONDS=30
SPAM_MESSAGES=6
SPAM_WINDOW_SECONDS=5
SPAM_TIMEOUT_MINUTES=10

# Если Discord доступен только через HTTP-прокси, укажите его (иначе оставьте пустым):
PROXY_URL=
